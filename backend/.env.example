# JanaSeva Backend Environment Configuration
# Copy this file to .env and configure values for your environment.
# NEVER commit real .env files with secrets into version control.

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# MongoDB Connection URI (credentials should not be committed to Git)
MONGODB_URI=mongodb://127.0.0.1:27017/janaseva

# Security & Authentication Secrets
# Provide a strong, cryptographically secure string (minimum 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long

# CORS Allowed Origins
# Comma-separated list of allowed frontend application origins (e.g., Volunteer App, Hub Terminal, Admin Dashboard)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
